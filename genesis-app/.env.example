# Genesis v0.2 environment - copy to .env and fill.
# GOLDEN RULE: no key = mock mode (full pipeline, canned providers).

# ?? Global mode ??????????????????????????????????????????????????????????????
# mock = canned providers (zero keys) | live = real calls | empty = auto-detect
GENESIS_MODE=

# ?? LLM provider (any OpenAI-compatible endpoint - NO vendor lock) ??????????
# GENESIS_PROVIDER: groq | openrouter | openai | ollama | custom
#   groq       https://api.groq.com/openai/v1        llama-3.3-70b-versatile
#   openrouter https://openrouter.ai/api/v1          meta-llama/llama-3.3-70b-instruct
#   openai     https://api.openai.com/v1             gpt-4o-mini
#   ollama     http://127.0.0.1:11434/v1             llama3.1:8b     (keyless, local)
#   custom     LLM_BASE_URL zaroori hai              LLM_MODEL zaroori hai
GENESIS_PROVIDER=groq
# Canonical API key (wins over legacy GROQ_API_KEY). LLM_API_KEY alone NEVER
# implies a vendor - set GENESIS_PROVIDER ya LLM_BASE_URL bhi.
LLM_API_KEY=
GROQ_API_KEY=
# Optional overrides (else preset defaults apply)
LLM_BASE_URL=
LLM_MODEL=
# JSON mode: auto (native response_format, auto-falls-back if provider rejects)
#            force (always send) | off (prompt-only)
LLM_JSON_MODE=auto
# Request timeout in seconds (default 90)
LLM_TIMEOUT=90

# ?? Search provider: tavily | searxng | mock ?????????????????????????????????
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional override (proxies/tests)
TAVILY_BASE_URL=https://api.tavily.com/search
# Self-hosted SearXNG (free, private). REQUIREMENT: instance settings.yml must
# contain  formats: [html, json]  warna 403 milega. Call: GET {base}/search?q=&format=json
SEARXNG_BASE_URL=
# Optional shared Bearer for either provider (authed SearXNG frontends etc.)
SEARCH_API_KEY=

# ?? Speech-to-text (optional; any /audio/transcriptions-compatible server) ??
# STT_ENABLED: auto (key ya STT_BASE_URL override par on) | 1 | 0 (mic force-off)
STT_ENABLED=auto
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# ?? Verdict scoring thresholds (0-100) ???????????????????????????????????????
THRESHOLD_VALIDATE=70
THRESHOLD_FIX_FIRST=45
