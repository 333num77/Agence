{
  "name": "genesis-engine",
  "version": "1.0.0",
  "description": "AI-Native Product Intelligence Platform - Transforming uncertain ideas into validated execution blueprints",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "ai",
    "product-intelligence",
    "validation",
    "engineering",
    "architecture",
    "llm",
    "automation"
  ],
  "author": "",
  "license": "ISC",
